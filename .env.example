# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public URL of the deployed app, used in sign-up confirmation emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Encrypts each person's own AI keys at rest (openssl rand -base64 32). Required.
# Changing it makes saved keys unreadable; people would re-enter them.
PROVIDER_KEYS_SECRET=

# Shared AI keys (optional). People add their own keys under AI keys (/settings);
# these are only used for a provider when the person hasn't added their own.
# Leave all blank to require everyone to bring their own.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Required only for user-scoped Anthropic keys (sk-ant-usr-...); workspace-scoped keys omit it
# ANTHROPIC_WORKSPACE_ID=

# Optional: comma-separated model ids to offer for OpenAI and Gemini
# OPENAI_MODELS=gpt-5
# GEMINI_MODELS=gemini-2.5-pro
